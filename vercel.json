{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/transcribe.py": {
      "maxDuration": 300,
      "excludeFiles": "{public/**,src/**,app/**,site/**,vendor/**,tests/**,dev/**,docs/**,scripts/**}"
    },
    "api/health.py": {
      "maxDuration": 10,
      "excludeFiles": "{public/**,src/**,app/**,site/**,vendor/**,tests/**,dev/**,docs/**,scripts/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
